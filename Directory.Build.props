<Project>

  <!-- Broiler NuGet packaging metadata (vendored; do not edit by hand). -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Broiler.Packaging.props" />

  <!-- Repository-owned packaging overrides. -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.DOM</PackageProjectUrl>
    <PackageTags>broiler;dom;html;html-parser;tokenizer;serializer;whatwg</PackageTags>
  </PropertyGroup>

</Project>
